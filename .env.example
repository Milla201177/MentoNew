DATABASE_URI=postgresql://user:password@host/dbname?sslmode=require
PAYLOAD_SECRET=YOUR_SECRET_HERE
BLOB_READ_WRITE_TOKEN=

# Public origin of the site. Optional locally; SET IT IN PRODUCTION once the
# real domain is live.
#
# Everything a crawler uses to decide which URL the site *is* derives from this
# one value: the canonical link, og:url, the sitemap entries, robots.txt's host
# line, the llms.txt links and the JSON-LD @ids. Left unset, it falls back to
# Vercel's own hostname, so the whole site canonicalises to
# <project>.vercel.app and that is the domain that gets indexed.
#
# NEXT_PUBLIC_SITE_URL=https://mento.vc
NEXT_PUBLIC_SITE_URL=
